# ── Client-safe environment variables (Vite) ────────────────────────────────
# Copy this file to `.env.local` and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# ⚠️  Only VITE_* keys belong here. They are bundled into the browser build.
#     NEVER put NVIDIA_API_KEY or the service_role key here — those live only as
#     Supabase Edge Function secrets (see README §7).

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key
